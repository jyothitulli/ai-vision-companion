# Secrets and Credentials (CRITICAL - DO NOT COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
*credentials*
*secret*

# Python
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Portable toolchain and local executables
.tools/
*.tar.gz
*.zip
*.7z
*.exe

# Large Model Weights and ML Caches (auto-downloaded at runtime)
backend/models/weights/
*.pt
*.pth
*.onnx
*.engine
*.bin
*.safetensors
.cache/
huggingface/
torch_cache/
*.part

# Temporary processing & uploads (never persist camera frames)
tmp/
temp_frames/
uploads/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / React Native / Expo
node_modules/
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
.expo/

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Databases & local state
*.db
*.sqlite
*.sqlite3
postgres_data/

# Evaluation output artifacts
evaluation/reports/*.json
evaluation/reports/*.html
!evaluation/reports/.gitkeep

# Dataset images (keep structure, never private images)
datasets/**/images/
!datasets/**/images/.gitkeep
