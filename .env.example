# Copy to .env and adjust. Never commit real secrets.

APP_ENV=development
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me-in-production

# PostgreSQL (docker-compose default). SQLite is used only if this URL is unset
# and ENABLE_SQLITE_FALLBACK=true.
DATABASE_URL=postgresql+asyncpg://vision:vision@localhost:5432/vision_companion
ENABLE_SQLITE_FALLBACK=true
SQLITE_PATH=./backend/data/vision_companion.db

# CORS: comma-separated origins. Use * only for local development.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,exp://127.0.0.1:8081

# Uploads
MAX_UPLOAD_BYTES=8388608
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Models (CPU-first defaults)
DEVICE=cpu
YOLO_MODEL=yolo11n.pt
YOLO_WORLD_MODEL=yolov8s-worldv2.pt
YOLO_CONFIDENCE=0.35
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
WHISPER_MODEL=tiny
ENABLE_OCR=true
ENABLE_YOLO_WORLD=true
ENABLE_DEPTH=true
ENABLE_TRACKING=true

# Uncalibrated monocular depth heuristic (NOT metric ground truth)
DEPTH_HIGHER_MEANS_FARTHER=true
DEPTH_NEAR_THRESHOLD=0.35
DEPTH_MID_THRESHOLD=0.65

# RATE LIMITS
RATE_LIMIT_ANALYZE=20/minute
RATE_LIMIT_SPEECH=30/minute
ENABLE_RATE_LIMIT=true

# Privacy
STORE_IMAGES=false
LOG_IMAGE_METADATA_ONLY=true
